# Output and runtime directories
artifacts/*
!artifacts/.gitkeep
outputs/*
!outputs/.gitkeep
.krun/
krun_outputs/
krun_project/

# Archive files
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Version control
.git/
.uv-cache/
inputs/proxy/
inputs/final/
inputs/overnight/
reports/work/
delivery/
